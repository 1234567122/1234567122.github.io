{
  "name": "lingshu/website-api",
  "description": "ThinkPHP API skeleton for LingShu Technology website.",
  "type": "project",
  "require": {
    "php": ">=8.2 <8.3",
    "topthink/framework": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
